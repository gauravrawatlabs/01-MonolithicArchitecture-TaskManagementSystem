{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Jwt": {
    "Issuer": "TaskManagementSystem",
    "Audience": "TaskManagementSystem.Clients",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "Email": {
    "FromAddress": "no-reply@taskmanagement.local",
    "PickupDirectory": "emails",
    "ClientAppBaseUrl": "http://localhost:3000"
  }
}
