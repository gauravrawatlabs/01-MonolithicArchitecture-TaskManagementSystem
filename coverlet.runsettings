<?xml version="1.0" encoding="utf-8"?>
<!--
  Code-coverage settings, used by: dotnet test with the settings option pointing to this file
  (see README "Testing"). Note: XML comments may not contain two consecutive hyphens.
  Measures only the application assembly and excludes generated code (EF Core migrations),
  which would otherwise dilute the percentage with thousands of lines nobody writes by hand.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[TaskManagementSystem]*</Include>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
